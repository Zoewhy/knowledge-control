APP_ENV=development
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./alg_qa.db
REDIS_URL=redis://localhost:6379/0
ELASTICSEARCH_URL=http://localhost:9200
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_CHAT_MODEL=qwen-plus
# 图片理解（VL）模型，用于扫描页/图片入库
BAILIAN_VL_MODEL=qwen-vl-plus
BAILIAN_EMBEDDING_MODEL=text-embedding-v3
BAILIAN_EMBEDDING_DIMENSIONS=1024
LLM_MOCK_MODE=true
# 文件入库执行模式：sync 同步 / celery 异步
INGEST_EXECUTION_MODE=sync
# 上传原文落盘目录与大小上限（MB）
UPLOAD_DIR=data/files
UPLOAD_MAX_MB=20
ENABLE_ELASTICSEARCH=false
# 图存储：true 使用 Neo4j（需 NEO4J_*），false 或未连通时降级为 SQL 共现图
ENABLE_NEO4J=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
AGENT_EXECUTION_MODE=sync
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://open.feishu.cn/open-apis
# 飞书事件订阅 verification token；留空时本地开发不做 token 校验
FEISHU_VERIFICATION_TOKEN=
# 预留：加密事件 AES key；当前版本未实现加密事件解密
FEISHU_ENCRYPT_KEY=
# 任务完成通知的默认群 chat_id
FEISHU_DEFAULT_CHAT_ID=
FEISHU_NOTIFY_ON_TASK_DONE=true
# 外部事件 payload 大小上限（字节）
INTEGRATION_PAYLOAD_MAX_BYTES=262144
RETRIEVAL_TIMEOUT_SECONDS=2.5
RETRIEVAL_MAX_WORKERS=5
WIKI_FALLBACK_SCORE=0.42
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VITE_API_BASE_URL=http://localhost:8000/api/v1
